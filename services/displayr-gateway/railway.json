{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/displayr-gateway/Dockerfile",
    "watchPatterns": [
      "/services/displayr-gateway/**",
      "/experiments/displayr-gateway/gateway.mjs",
      "/lib/portal/displayr-invitation-link.ts"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
