# Copy into the portal's SERVER environment when the isolated pilot is ready.
# Keep disabled until the SQL, gateway host and private secrets are configured.
DISPLAYR_GATEWAY_ENABLED=false
DISPLAYR_GATEWAY_PILOT_USER_IDS=user-arif
DISPLAYR_GATEWAY_USE_PRIVATE_TEST_COPY=true
# Use an isolated HTTPS gateway origin, and a private authenticated control origin.
DISPLAYR_GATEWAY_PUBLIC_ORIGIN=
DISPLAYR_GATEWAY_CONTROL_ORIGIN=
DISPLAYR_CONTROL_SECRET=
DISPLAYR_AUTHORIZATION_SECRET=
# Existing SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are required.
